#!/usr/bin/env bash
# Move heavy build dirs of a project to the HD and leave symlinks behind.
# Also supports removing a project's HD artifacts and symlinks, and listing.
#
# Usage:
#   build-to-hd <project-dir> [rust|node|auto]
#   build-to-hd remove <project-dir>
#   build-to-hd list
set -euo pipefail

HD=/mnt/linux-data
[ -d "$HD" ] || { echo "HD not mounted at $HD" >&2; exit 1; }

usage() { echo "Usage: build-to-hd <project-dir> [rust|node|auto] | build-to-hd remove <project-dir> | build-to-hd list" >&2; exit 1; }
[ $# -ge 1 ] || usage

list_projects() {
  echo "Projects on HD ($HD):"
  shopt -s nullglob
  local found=0
  for hd_dir in "$HD"/*/; do
    [ -d "$hd_dir" ] || continue
    # Only show dirs that hold build artifacts
    [ -d "$hd_dir/target" ] || [ -d "$hd_dir/node_modules" ] || continue
    found=1
    name=$(basename "$hd_dir")
    size=$(du -sh "$hd_dir" 2>/dev/null | cut -f1)
    src=""
    for base in /home/iarley/Projects /home/iarley/Work; do
      if [ -d "$base/$name" ]; then src="$base/$name"; break; fi
    done
    if [ -n "$src" ]; then
      syms=""
      [ -L "$src/target" ] && syms="target"
      [ -L "$src/node_modules" ] && syms="${syms:+$syms,}node_modules"
      [ -z "$syms" ] && syms="none"
      echo "  $name  size=$size  source=$src  symlinks=[$syms]"
    else
      echo "  $name  size=$size  source=MISSING"
    fi
  done
  shopt -u nullglob
  if [ "$found" -eq 0 ]; then
    echo "  (none)"
  fi
}

remove_project() {
  project=$(realpath "$1")
  name=$(basename "$project")
  hd="$HD/$name"
  echo "Removing HD artifacts for: $name"

  for d in target node_modules; do
    if [ -L "$project/$d" ]; then
      rm -f "$project/$d"
      echo "  removed symlink: $project/$d"
    fi
  done

  if [ -d "$hd" ]; then
    rm -rf "$hd"
    echo "  removed HD dir: $hd"
  else
    echo "  no HD dir: $hd"
  fi

  if [ -f "$project/.cargo/config.toml" ]; then
    if grep -q "target-dir = \"$hd/target\"" "$project/.cargo/config.toml" 2>/dev/null; then
      rm -f "$project/.cargo/config.toml"
      rmdir "$project/.cargo" 2>/dev/null || true
      echo "  removed .cargo/config.toml"
    fi
  fi
}

# Subcommands
case "$1" in
  list|ls|status)
    list_projects
    exit 0
    ;;
  remove|rm)
    [ $# -ge 2 ] || usage
    remove_project "$2"
    exit 0
    ;;
esac

project=$(realpath "$1")
mode=${2:-auto}
name=$(basename "$project")
hd="$HD/$name"

do_rust() {
  mkdir -p "$hd"
  if [ -e "$project/target" ] && [ ! -L "$project/target" ]; then
    mv "$project/target" "$hd/target"
  elif [ ! -e "$project/target" ]; then
    mkdir -p "$hd/target"
  fi
  if [ ! -L "$project/target" ]; then
    ln -s "$hd/target" "$project/target"
  fi
  mkdir -p "$project/.cargo"
  cat > "$project/.cargo/config.toml" <<EOF
[build]
target-dir = "$hd/target"
EOF
  echo "rust: $project/target -> $hd/target"
}

do_node() {
  mkdir -p "$hd"
  if [ -e "$project/node_modules" ] && [ ! -L "$project/node_modules" ]; then
    mv "$project/node_modules" "$hd/node_modules"
  elif [ ! -e "$project/node_modules" ]; then
    mkdir -p "$hd/node_modules"
  fi
  if [ ! -L "$project/node_modules" ]; then
    ln -s "$hd/node_modules" "$project/node_modules"
  fi
  echo "node: $project/node_modules -> $hd/node_modules"
}

case "$mode" in
  rust) do_rust ;;
  node) do_node ;;
  auto)
    [ -f "$project/Cargo.toml" ] && do_rust || true
    [ -f "$project/package.json" ] && do_node || true
    ;;
  *) usage ;;
esac
